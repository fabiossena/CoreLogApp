# ===========================================================================
# CoreLog web dashboard — ASP.NET Core MVC (.NET 8) multi-stage build.
#
#   docker build -f Dockerfile.web -t corelog-web:1.0.0 .
#
# Stage 1 publishes the MVC application (Razor views + wwwroot).
# Stage 2 serves it with the ASP.NET Core runtime image.
# ===========================================================================

ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
ARG DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:8.0

# ---------------------------------------------------------------------------
# Stage 1 — restore + publish
# ---------------------------------------------------------------------------
FROM ${DOTNET_SDK_IMAGE} AS build

WORKDIR /src

# Restore first so the layer is cached across source changes.
COPY web/CoreLog.Web.csproj web/
RUN dotnet restore web/CoreLog.Web.csproj

COPY web/ web/
RUN dotnet publish web/CoreLog.Web.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore \
    /p:UseAppHost=false

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM ${DOTNET_RUNTIME_IMAGE} AS runtime

WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true

COPY --from=build /app/publish .

EXPOSE 8080

ENTRYPOINT ["dotnet", "CoreLog.Web.dll"]
