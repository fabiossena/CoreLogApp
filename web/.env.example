# ---------------------------------------------------------------------------
# CoreLog web dashboard configuration
#
# IMPORTANT — Vite only exposes variables prefixed with `VITE_` to the browser
# bundle (via import.meta.env). The unprefixed keys below are NOT read by Vite;
# they are kept for parity with the mobile app / backend configuration and for
# any future server-side proxy. The dashboard reads the `VITE_` variants.
# ---------------------------------------------------------------------------

# Base URL of the CoreLog backend REST API (server-side reference value).
CORELOG_BASE_URL=http://localhost:8090

# SignalR hub URL of the CoreLog TrackingHub (server-side reference value).
SIGNALR_HUB_URL=http://localhost:8090/hubs/tracking

# Base URL of the CoreLog backend REST API, bundled into the browser client.
# Used by CoreLogClient for every REST call (devices, panics, commands, ...).
#
# Docker / Kubernetes: set `same-origin` so the browser calls this page's own
# origin and nginx reverse-proxies /api and /hubs to the backend
# (see docker/nginx.conf.template and Dockerfile.web).
VITE_CORELOG_BASE_URL=http://localhost:8090

# TrackingHub URL used by the SignalR client. Absolute http(s) URL, or a path
# (e.g. /hubs/tracking) which is resolved against VITE_CORELOG_BASE_URL.
VITE_SIGNALR_HUB_URL=http://localhost:8090/hubs/tracking

# Operator identity sent when acknowledging panic events
# (POST /api/panic/{panicId}/ack body: { "operator": "<value>" }).
VITE_OPERATOR_ID=fabio.sena

# Optional: TTL in milliseconds for local list-query cache entries (default 10000).
VITE_CACHE_TTL_MS=10000
