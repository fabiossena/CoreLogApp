# Copy to `android/keystore.properties` and fill in real values.
#
# `storeFile` is relative to the `android/` directory. Keep the keystore and
# this file OUT of version control (already covered by mobile/.gitignore).
#
# Generate the upload keystore once (see android/keystore/README.md):
#   keytool -genkeypair -v -storetype JKS \
#     -keystore android/keystore/corelog-upload.jks \
#     -alias corelog-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/corelog-upload.jks
storePassword=change-me
keyAlias=corelog-upload
keyPassword=change-me
