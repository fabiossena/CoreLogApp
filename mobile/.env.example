# CoreLog mobile app — copy to `.env` and adjust.
# Values are read by `src/config/env.ts` (see README, "Configuration").

# Base URL of the CoreLog backend (no trailing slash).
CORELOG_BASE_URL=https://api.corelog.example.com

# Firebase Cloud Messaging sender id used by CoreLog to address this device.
FCM_SENDER_ID=123456789000

# Maximum number of positions sent in one POST /api/tracking/events batch.
BATCH_SIZE=10

# Seconds between two native position samples (overridable by SET_FREQUENCY).
POSITION_INTERVAL_SECONDS=60
