# ---------------------------------------------------------------------------
# Local verification image (NOT the production build).
#
# The production `/Dockerfile.web` runs `npm ci` + `vite build` inside the
# container. When the npm/Docker registry is unreachable (offline or CI outage)
# you can still assemble an identical runtime image from a bundle built on the
# host:
#
#   cd web && VITE_CORELOG_BASE_URL=same-origin npm run build && cd ..
#   docker build -f docker/Dockerfile.runtime -t corelog-web:1.0.0 .
#
# The resulting image is behaviourally identical to the multi-stage build:
# nginx serves `web/dist` and reverse-proxies /api + /hubs to CORELOG_UPSTREAM.
# ---------------------------------------------------------------------------
ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NGINX_IMAGE}

COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY web/dist /usr/share/nginx/html

ENV CORELOG_UPSTREAM=http://corelog:8090 \
    NGINX_RESOLVER=127.0.0.11

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
