# ---------------------------------------------------------------------------
# CoreLog web dashboard — nginx configuration (templated).
#
# Rendered to /etc/nginx/conf.d/default.conf by the nginx image at startup
# using the environment variables:
#   CORELOG_UPSTREAM  e.g. http://corelog:8090  (the CoreLog backend)
#   NGINX_RESOLVER   DNS server, default 127.0.0.11 (Docker embedded DNS);
#                    use 10.96.0.10 (kube-dns) inside Kubernetes.
#
# The upstream host is intentionally resolved LAZILY (resolver + variable in
# proxy_pass) instead of at config-load time, so the dashboard still boots
# when the backend is not reachable yet and recovers as soon as it is.
#
# Responsibilities:
#   1. Serve the static SPA built by Vite (with index.html fallback).
#   2. Reverse-proxy the CoreLog REST API and the SignalR hub so the browser
#      only ever talks to this origin (no CORS, no direct device access).
# ---------------------------------------------------------------------------

# Upgrade WebSocket connections for the SignalR hub.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    # DNS used to resolve $corelog_upstream at request time.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # Resolved on demand — never blocks startup.
    set $corelog_upstream ${CORELOG_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # --- Static assets -----------------------------------------------------
    # Vite emits hashed filenames, so they are safe to cache aggressively.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # --- Health probe (used by the container HEALTHCHECK and k8s probes) ---
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # --- CoreLog REST API --------------------------------------------------
    # /api/** is forwarded to the backend defined by CORELOG_UPSTREAM.
    # With a variable proxy_pass the original request URI is forwarded as-is,
    # so /api/tracking/events -> $corelog_upstream/api/tracking/events.
    location /api/ {
        proxy_pass $corelog_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # --- CoreLog SignalR hub (WebSocket) -----------------------------------
    location /hubs/ {
        proxy_pass $corelog_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;   # keep long-lived WebSockets open
        proxy_send_timeout 3600s;
        proxy_buffering off;        # required for streaming
    }

    # --- SPA fallback ------------------------------------------------------
    # Any other route is handled by the client-side router.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers (the dashboard handles operational data).
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header Referrer-Policy no-referrer;
}